PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CLIENT_ORIGIN=*

# dev | prod
APP_ENV=dev
MAIL_MODE=dev

# DEV MODE
# Письма не отправляются на реальный ящик.
# Они сохраняются в backend/test-mails и доступны через /mail-preview.
MAIL_PREVIEW_DIR=./test-mails

# PROD MODE
MAIL_TO=info@example.com
MAIL_FROM=Site <no-reply@example.com>
MAIL_REPLY_TO=info@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=super-secret-password
